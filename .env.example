# Copy to .env. Keep .env private; never put provider keys in Flutter.
# Control is loopback-only until you explicitly choose your Mac's Tailscale IP.
ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=8787
ORCHESTRATOR_DB=.data/orchestrator.sqlite
ORCHESTRATOR_MODE=live
# Colon-separated directories where new project worktrees may be created.
ORCHESTRATOR_PROJECT_ROOTS=
CODEX_BIN=codex
# Leave unset to use the available Codex default model.
# CODEX_MODEL=

# Public media URL is what the phone receives; this default is for the emulator.
LIVEKIT_URL=ws://10.0.2.2:7880
LIVEKIT_INTERNAL_URL=ws://127.0.0.1:7880
# Generated by `node scripts/init-local.mjs`; local credentials, not cloud login.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Set to your Mac's Tailscale IP for physical-device media routing.
LIVEKIT_NODE_IP=127.0.0.1

# Speech requires separate OpenAI API billing, not your Codex subscription.
OPENAI_API_KEY=
# Live captions; local VAD gates upstream audio. Use gpt-4o-mini-transcribe
# for the cheaper buffered fallback (no while-speaking captions).
OPENAI_STT_MODEL=gpt-live-transcribe
# Choose openai or elevenlabs for spoken replies; STT stays on OpenAI.
TTS_PROVIDER=openai
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# Optional ElevenLabs TTS; adding a key does not switch providers.
ELEVEN_API_KEY=
ELEVEN_TTS_MODEL=eleven_flash_v2_5
ELEVEN_TTS_VOICE_ID=
